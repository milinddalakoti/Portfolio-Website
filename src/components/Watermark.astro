---
/**
 * Watermark.astro
 *
 * Oversized editorial name watermark used as a quiet background
 * mark above the footer. Set in Instrument Serif at clamp(4rem, 10vw, 6rem)
 * on mobile → clamp(5rem, 12vw, 9rem) on sm → clamp(6rem, 14vw, 12rem) on md+.
 * Very low opacity (0.06), sits behind the footer content.
 *
 * The text is purely decorative; aria-hidden.
 */
export interface Props {
  text?: string;
  class?: string;
}
const { text = "Milind Dalakoti", class: cls = "" } = Astro.props;
---

<div
  class:list={["watermark pointer-events-none relative -mb-12 overflow-hidden", cls]}
  aria-hidden="true"
>
  <p
    class="display-heading select-none whitespace-nowrap text-center text-[clamp(2rem,6.5vw,4.5rem)] leading-[0.85] text-ink/[0.06] sm:text-[clamp(4rem,10vw,6rem)] md:text-[clamp(6rem,14vw,12rem)]"
    style="letter-spacing:-0.05em; font-weight:800;"
  >
    {text}
  </p>
</div>
