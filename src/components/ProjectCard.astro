---
export interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  status: "shipped" | "in-progress" | "research" | "placeholder";
  stack: string[];
  metrics?: Array<{ label: string; value: string }>;
}

const { href, title, summary, date, status, stack, metrics = [] } = Astro.props;

const statusColor = {
  shipped: "border-hairline-mist bg-cream-paper text-ink-black",
  "in-progress": "border-hairline-mist bg-cream-paper text-ink-black",
  research: "border-hairline-mist bg-cream-paper text-ink-black",
  placeholder: "border-hairline-mist bg-sandstone text-ink-black",
};

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IE", { year: "numeric", month: "short" });
---

<a href={href} class="card group block h-full flex flex-col no-underline">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">{fmt(date)}</p>
      <h3
        class="display-heading mt-3 text-2xl font-bold tracking-tight text-ink transition-colors group-hover:text-accent sm:text-3xl"
      >
        {title}
      </h3>
    </div>
    <span
      class:list={[
        "inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 text-[10px] uppercase tracking-wider",
        statusColor,
      ]}
    >
      {status.replace("-", " ")}
    </span>
  </div>
  <p class="mt-5 text-base text-ink leading-relaxed font-medium">{summary}</p>

  {
    metrics.length > 0 && (
      <dl class="mt-7 grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-3">
        {metrics.map((m) => (
          <div>
            <dt class="eyebrow">{m.label}</dt>
            <dd class="display-heading mt-2 text-xl text-ink">{m.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="mt-7 flex flex-wrap gap-1.5">
    {
      stack.slice(0, 6).map((s) => (
        <li class="chip">{s}</li>
      ))
    }
  </ul>

  <p class="mt-auto text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100">
    Read case study →
  </p>
</a>