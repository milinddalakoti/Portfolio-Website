---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { slots } from "@/data/nav-slots";

// Derived from the shared slots data so there's a single source of truth.
const base = import.meta.env.BASE_URL || "";
const links = slots.map((s) => ({ href: base + s.href, label: s.label }));
const slotsData = slots.map((s) => ({
  ...s,
  href: base + s.href,
  // matchPrefixes intentionally WITHOUT base — compared against
  // base-stripped pathname in the highlight script.
}));
---

<header data-nav data-base={base} class="fixed top-6 left-0 right-0 z-40 flex justify-center">
  <nav
    class="inline-flex items-center gap-2 sm:gap-4 rounded-full bg-pure-white border border-hairline-mist px-3 sm:px-5 py-2 text-sm"
    data-slots={JSON.stringify(slotsData)}
  >
    <a
      href={base + "/#home"}
      class="font-medium text-ink-black text-base no-underline"
    >
      Milind Dalakoti
    </a>
    <!-- Section links — hidden on mobile (MobileDock handles that) -->
    <ul class="hidden items-center gap-x-1 md:ml-2 md:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              class="inline-flex items-center justify-center rounded-full px-4 py-2 font-medium text-sm text-ink-black/80 hover:text-ink-black hover:bg-cream-paper transition-colors"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <!-- Theme toggle + contact button — always visible, compact on mobile -->
    <div class="ml-auto flex items-center gap-2">
      <span class="ml-2">
        <ThemeToggle />
      </span>
      <a
        href={base + "/#contact"}
        class="inline-flex items-center rounded-full bg-ink-black px-3 py-1.5 text-[10px] font-medium text-cream-paper hover:bg-fresh-grass md:px-5 md:py-2.5 md:text-sm"
      >
        Get in touch
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    function norm(p) { return (p || "").replace(/\/+$/, "") || "/"; }
    function stripBase(p, base) {
      if (base && p.indexOf(base) === 0) {
        return p.substring(base.length) || "/";
      }
      return p;
    }
    // Active-link highlight. On the single-page home, the active link is
    // whichever section the URL hash points to (/#projects, /#skills, ...).
    // On a deep page (e.g. /projects/quantum-brain-tumor), the Projects link
    // is active via the deepPrefixes fallback.
    // Guard: prevent duplicate listener registration on view transitions.
    if (window.__navHighlightSynced) {
      window.__navHighlightSynced();
      return;
    }
    // Read base path and deep-route prefixes from server-rendered attributes.
    var nav = document.querySelector("[data-nav]");
    var base = nav ? nav.getAttribute("data-base") || "" : "";
    var slotsData = JSON.parse(nav ? nav.getAttribute("data-slots") || "[]" : "[]");
    var deepPrefixes = {};
    for (var i = 0; i < slotsData.length; i++) {
      if (slotsData[i].matchPrefixes && slotsData[i].matchPrefixes.length) {
        deepPrefixes[slotsData[i].href] = slotsData[i].matchPrefixes;
      }
    }
    function highlight() {
      var rawPath = window.location.pathname;
      var path = norm(rawPath);
      path = norm(stripBase(path, base));
      var hash = window.location.hash || "";
      var links = document.querySelectorAll("[data-nav-link]");
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute("href") || "";
        var linkPath = norm(href.split("#")[0] || "/");
        linkPath = norm(stripBase(linkPath, base));
        var linkHash = href.split("#")[1] || "";
        var active = false;
        if (linkPath === path) {
          if (!linkHash || linkHash === "home") {
            active = !hash || hash === "#home";
          } else {
            active = hash === "#" + linkHash;
          }
        }
        if (!active && deepPrefixes[href]) {
          for (var j = 0; j < deepPrefixes[href].length; j++) {
            var pfx = norm(deepPrefixes[href][j]);
            if (path === pfx || path.indexOf(pfx + "/") === 0 || path.indexOf(pfx) === 0) {
              active = true; break;
            }
          }
        }
        if (active) {
          links[i].setAttribute("aria-current", "page");
          links[i].classList.add("bg-fresh-grass", "text-ink-black");
          links[i].classList.remove("text-ink-black/80", "hover:bg-cream-paper");
        } else {
          links[i].removeAttribute("aria-current");
          links[i].classList.remove("bg-fresh-grass", "text-ink-black");
          links[i].classList.add("text-ink-black/80", "hover:bg-cream-paper");
        }
      }
    }
    window.__navHighlightSynced = highlight;
    window.addEventListener("hashchange", highlight);
    window.addEventListener("DOMContentLoaded", highlight);
    window.addEventListener("astro:navigation-end", highlight);
  })();
</script>
