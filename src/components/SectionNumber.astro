---
/**
 * SectionNumber.astro
 *
 * Decorative large faded section number (e.g. "01/") anchored to the right
 * edge of a section. Pure decoration — aria-hidden. Uses the display font
 * (Instrument Serif) at 200px+ in the muted ink color.
 */
export interface Props {
  /** 1-based section number, e.g. 1 -> "01/" */
  n: number;
  /** Total in the sequence, e.g. 3 -> "of 03" */
  total?: number;
  class?: string;
}
const { n, total = 3, class: cls = "" } = Astro.props;
const padded = String(n).padStart(2, "0");
const totalPadded = String(total).padStart(2, "0");
---

<div
  aria-hidden="true"
  class={"pointer-events-none select-none font-display text-[clamp(7rem,18vw,14rem)] leading-none text-ink/[0.06] tracking-tighter " + cls}
>
  {padded}<span class="text-ink/[0.04]">/{totalPadded}</span>
</div>
