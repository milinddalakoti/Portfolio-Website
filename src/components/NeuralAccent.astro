---
/**
 * NeuralAccent.astro
 *
 * Decorative inline SVG of a small neural-network / data-flow graph. Used as
 * an accent in the hero. Stroke-only, monochrome ink, semi-transparent.
 * aria-hidden. Includes a subtle slow pulse on one node.
 */
export interface Props {
  class?: string;
  /** size in px, defaults to 200 */
  size?: number;
}
const { class: cls = "", size = 200 } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 200 120"
  width={size}
  height={size * 0.6}
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  class:list={["text-ink/40", cls]}
>
  <!-- Input layer (3 nodes) -->
  <circle cx="20" cy="30" r="3" class="pulse-1" />
  <circle cx="20" cy="60" r="3" class="pulse-2" />
  <circle cx="20" cy="90" r="3" class="pulse-3" />
  <!-- Hidden layer (4 nodes) -->
  <circle cx="100" cy="20" r="3" />
  <circle cx="100" cy="46" r="3" />
  <circle cx="100" cy="74" r="3" />
  <circle cx="100" cy="100" r="3" />
  <!-- Output layer (2 nodes) -->
  <circle cx="180" cy="40" r="3" />
  <circle cx="180" cy="80" r="3" />

  <!-- Connections (input -> hidden) -->
  <line x1="20" y1="30" x2="100" y2="20" />
  <line x1="20" y1="30" x2="100" y2="46" />
  <line x1="20" y1="60" x2="100" y2="20" />
  <line x1="20" y1="60" x2="100" y2="46" />
  <line x1="20" y1="60" x2="100" y2="74" />
  <line x1="20" y1="60" x2="100" y2="100" />
  <line x1="20" y1="90" x2="100" y2="74" />
  <line x1="20" y1="90" x2="100" y2="100" />

  <!-- Connections (hidden -> output) -->
  <line x1="100" y1="20" x2="180" y2="40" />
  <line x1="100" y1="46" x2="180" y2="40" />
  <line x1="100" y1="46" x2="180" y2="80" />
  <line x1="100" y1="74" x2="180" y2="40" />
  <line x1="100" y1="74" x2="180" y2="80" />
  <line x1="100" y1="100" x2="180" y2="80" />
</svg>

<style>
  .pulse-1,
  .pulse-2,
  .pulse-3 {
    fill: currentColor;
    transform-origin: center;
    transform-box: fill-box;
    animation: pulse-node 2.4s ease-in-out infinite;
  }
  .pulse-2 {
    animation-delay: 0.6s;
  }
  .pulse-3 {
    animation-delay: 1.2s;
  }
  @keyframes pulse-node {
    0%, 100% { opacity: 0.3; r: 2.4; }
    50% { opacity: 0.9; r: 3.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-1, .pulse-2, .pulse-3 { animation: none; opacity: 0.6; }
  }
</style>
